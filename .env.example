# No secrets belong in this file. Copy to .env and adjust for your environment.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=learnmate
# For non-Docker local mode, leave QDRANT_URL blank and use QDRANT_PATH.
QDRANT_PATH=./database/qdrant
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=learnmate
MONGODB_COLLECTION=messages
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
DENSE_TOP_K=10
BM25_TOP_K=10
TOP_K=5
RRF_K=60
MEMORY_WINDOW=10
