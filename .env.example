# No secrets belong in this file. Copy to .env and adjust for your environment.
API_HOST=127.0.0.1
API_PORT=8000
# Local mode uses the repository's persistent Qdrant storage. Docker Compose overrides this.
QDRANT_URL=
QDRANT_COLLECTION=learnmate
QDRANT_PATH=./database/qdrant
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=learnmate
MONGODB_COLLECTION=messages
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_PREDICT=256
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Use a cached model locally; set false in an image-build/provisioning environment.
EMBEDDING_LOCAL_FILES_ONLY=true
DENSE_TOP_K=10
BM25_TOP_K=10
TOP_K=5
RRF_K=60
MEMORY_WINDOW=10
LOG_LEVEL=INFO
